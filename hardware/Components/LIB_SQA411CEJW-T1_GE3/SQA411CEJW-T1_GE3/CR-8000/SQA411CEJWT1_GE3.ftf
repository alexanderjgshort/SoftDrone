(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r62.5_35
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 35000)
            (height 62500)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r100_32
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 32000)
            (height 100000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r110_103
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 103000)
            (height 110000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r62.5_35
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r62.5_35))
          (noconnect (pad r62.5_35))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r62.5_35))
          (noconnect (pad r62.5_35))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r62.5_35))
          (noconnect (pad r62.5_35))
        )
      )
      (padstack r100_32
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r100_32))
          (noconnect (pad r100_32))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r100_32))
          (noconnect (pad r100_32))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r100_32))
          (noconnect (pad r100_32))
        )
      )
      (padstack r110_103
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r110_103))
          (noconnect (pad r110_103))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r110_103))
          (noconnect (pad r110_103))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r110_103))
          (noconnect (pad r110_103))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "SQA411CEJWT1_GE3"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -102500 -102500
                        (width 10000)
                      )
                      (pt 102500 -102500
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 102500 -102500
                        (width 10000)
                      )
                      (pt 102500 102500
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 102500 102500
                        (width 10000)
                      )
                      (pt -102500 102500
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -102500 102500
                        (width 10000)
                      )
                      (pt -102500 -102500
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 202500 237500)
                    (pt 202500 -237500)
                    (pt -202500 -237500)
                    (pt -202500 237500)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 65000 180000
                        (width 10000)
                      )
                      (pt 65000 180000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt 65000 180000
                            (width 10000)
                          )
                        )
                        (center 0 1073741824)
                        (end
                          (pt 65000 190000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt 65000 190000
                            (width 10000)
                          )
                        )
                        (center 0 -1073741824)
                        (end
                          (pt 65000 180000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt 65000 106300)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 65000 106300)
                  (angle 0)
                  (padstackGroup default (padstack r62.5_35))
                )
              )
            )
          )
          (pin 2
            (pt 0 106300)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 106300)
                  (angle 0)
                  (padstackGroup default (padstack r62.5_35))
                )
              )
            )
          )
          (pin 3
            (pt -65000 106300)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -65000 106300)
                  (angle 0)
                  (padstackGroup default (padstack r62.5_35))
                )
              )
            )
          )
          (pin 4
            (pt -65000 -106200)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -65000 -106200)
                  (angle 0)
                  (padstackGroup default (padstack r62.5_35))
                )
              )
            )
          )
          (pin 5
            (pt 0 -106200)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 -106200)
                  (angle 0)
                  (padstackGroup default (padstack r62.5_35))
                )
              )
            )
          )
          (pin 6
            (pt 65000 -106200)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 65000 -106200)
                  (angle 0)
                  (padstackGroup default (padstack r62.5_35))
                )
              )
            )
          )
          (pin 7
            (pt -74000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -74000 0)
                  (angle 0)
                  (padstackGroup default (padstack r100_32))
                )
              )
            )
          )
          (pin 8
            (pt 31000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 31000 0)
                  (angle 0)
                  (padstackGroup default (padstack r110_103))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape SQA411CEJW-T1_GE3.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

