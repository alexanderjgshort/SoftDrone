(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c30.6
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 15300
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c30.6
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad c30.6))
          (noconnect (pad c30.6))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c30.6))
          (noconnect (pad c30.6))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad c30.6))
          (noconnect (pad c30.6))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "BGA9C50P3X3_146X148X68"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 174500 175700)
                    (pt 174500 -175700)
                    (pt -174400 -175700)
                    (pt -174400 175700)
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -72900 74200
                        (width 10000)
                      )
                      (pt 72900 74200
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 72900 74200
                        (width 10000)
                      )
                      (pt 72900 -74200
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 72900 -74200
                        (width 10000)
                      )
                      (pt -72900 -74200
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -72900 -74200
                        (width 10000)
                      )
                      (pt -72900 74200
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -72900 36400
                        (width 10000)
                      )
                      (pt -35100 74200
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -50000 100300
                        (width 20000)
                      )
                      (pt 100300 100300
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 100300 100300
                        (width 20000)
                      )
                      (pt 100300 -100300
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 100300 -100300
                        (width 20000)
                      )
                      (pt -100300 -100300
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -100300 -100300
                        (width 20000)
                      )
                      (pt -100300 50000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -100300 50000
                        (width 20000)
                      )
                      (pt -50000 100300
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 10000)
                        (begin
                          (pt -100300 110300
                            (width 20000)
                          )
                        )
                        (center 0 0)
                        (end
                          (pt -100300 110300
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin A1
            (pt -50000 50000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -50000 50000)
                  (angle 90)
                  (padstackGroup default (padstack c30.6))
                )
              )
            )
          )
          (pin A2
            (pt 0 50000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 50000)
                  (angle 90)
                  (padstackGroup default (padstack c30.6))
                )
              )
            )
          )
          (pin A3
            (pt 50000 50000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 50000 50000)
                  (angle 90)
                  (padstackGroup default (padstack c30.6))
                )
              )
            )
          )
          (pin B1
            (pt -50000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -50000 0)
                  (angle 90)
                  (padstackGroup default (padstack c30.6))
                )
              )
            )
          )
          (pin B2
            (pt 0 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 0)
                  (angle 90)
                  (padstackGroup default (padstack c30.6))
                )
              )
            )
          )
          (pin B3
            (pt 50000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 50000 0)
                  (angle 90)
                  (padstackGroup default (padstack c30.6))
                )
              )
            )
          )
          (pin C1
            (pt -50000 -50000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -50000 -50000)
                  (angle 90)
                  (padstackGroup default (padstack c30.6))
                )
              )
            )
          )
          (pin C2
            (pt 0 -50000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 -50000)
                  (angle 90)
                  (padstackGroup default (padstack c30.6))
                )
              )
            )
          )
          (pin C3
            (pt 50000 -50000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 50000 -50000)
                  (angle 90)
                  (padstackGroup default (padstack c30.6))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape LM4670ITL_NOPB.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

